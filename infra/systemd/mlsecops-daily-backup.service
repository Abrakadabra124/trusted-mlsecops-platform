[Unit]
Description=Create and verify the owned local-cpu promotion backup
After=docker.service

[Service]
Type=oneshot
User=mlsecops
WorkingDirectory=/srv/trusted-mlsecops-platform
Environment=DOCKER_HOST=unix:///run/docker.sock PYTHONNOUSERSITE=1
UMask=0077
StateDirectory=mlsecops-backup
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/srv/trusted-mlsecops-platform/.runtime
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=12min
ExecStart=/srv/trusted-mlsecops-platform/.venv/bin/python -B -m mlsecops.daily_backup run --state /srv/trusted-mlsecops-platform/.runtime --owner /etc/mlsecops/backup-owner.json --inventory /var/lib/mlsecops-backup/latest.json
